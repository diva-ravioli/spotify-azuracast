{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spotify-azuracast",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ADAPTER", "class_name": "Adapter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Adapter"] }]
}
